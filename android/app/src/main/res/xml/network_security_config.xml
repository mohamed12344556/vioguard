<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) only to local dev backends:
         10.0.2.2  -> host machine's localhost from the Android emulator
         localhost / 127.0.0.1 -> loopback
         192.168.x.x -> host LAN IP for real devices on the same Wi-Fi -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.1.2</domain>
    </domain-config>
</network-security-config>
